{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Permissions-Policy",
          "value": "pointer-lock=*, fullscreen=(self), gamepad=(self)"
        }
      ]
    }
  ]
}
