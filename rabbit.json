{
  "contract": 1,
  "stack": "playcanvas-3d",
  "embed": {
    "audio": true,
    "pointerLock": true,
    "storage": false
  },
  "topology": {
    "profileVersion": 1,
    "worldVersion": 6,
    "style": "voxel-sandbox",
    "catalog": { "objects": false, "characters": false },
    "surfaces": {
      "player": [
        { "path": "src/game.config.ts", "symbols": ["player"] },
        { "path": "src/entities/player-avatar.ts", "symbols": ["createPlayerAvatar"] }
      ],
      "movement": [
        { "path": "src/game.config.ts", "symbols": ["player"] },
        { "path": "src/sim/player.ts", "symbols": ["stepPlayer"] }
      ],
      "world": [
        { "path": "src/game.config.ts", "symbols": ["world"] },
        { "path": "src/voxel/generator.ts", "symbols": ["generateWorld"] }
      ],
      "rules": [
        { "path": "src/game.config.ts", "symbols": ["session", "interaction"] },
        { "path": "src/sim/session.ts", "symbols": ["GameSession"] },
        { "path": "src/game.config.ts", "symbols": ["ironGolem", "animals"] },
        { "path": "src/creatures/planner.ts", "symbols": ["creatureGroupEntries"] },
        { "path": "src/sim/creature-guardian.ts", "symbols": ["stepGuardian", "GUARDIAN"] }
      ],
      "camera": [
        { "path": "src/game.config.ts", "symbols": ["camera"] },
        { "path": "src/entities/camera-rig.ts", "symbols": ["createCameraRig"] }
      ],
      "assets": [
        { "path": "src/data/assets.ts", "symbols": ["ASSETS"] },
        { "path": "src/data/blocks.ts", "symbols": ["BLOCKS"] }
      ],
      "presentation": [
        { "path": "src/game.config.ts", "symbols": ["environment", "visual", "audio"] },
        { "path": "src/entities/environment.ts", "symbols": ["createEnvironment"] },
        { "path": "src/systems/hud.ts", "symbols": ["createHud"] },
        { "path": "src/entities/creature-golem.ts", "symbols": ["createGolemMeshes", "poseGolem"] }
      ]
    }
  }
}
